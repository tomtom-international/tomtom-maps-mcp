# Node.js dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Package manager lock files (this project uses pnpm; keep pnpm-lock.yaml).
# Unanchored: no package in this repo — root or workspace member — carries an
# npm or yarn lockfile of its own.
package-lock.json
yarn.lock

# pnpm's local content-addressable store, when it lands in the repo
.pnpm-store/

# TypeScript output
dist/
*.tsbuildinfo

# Environment variables
.env
.env.local
.env.development
.env.test
.env.production
.env.backup
.env*.local

# IDE files
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json
*.sublime-*
*.swp
*.swo

# OS specific files
.DS_Store
Thumbs.db
desktop.ini

# Test output and coverage
test-output/
coverage/

# Playwright
playwright-report/
test-results/
blob-report/

# Temporary directories
temp/
tmp/

# Logs
logs/
*.log

# Debug files
debug-*.js
debug.log

# Local development scripts
*local*.sh
*claude*.sh

# Local Claude settings
.claude/*.local.*

# Unwanted test files (replaced with organized tests)
test-*.js
!tests/test-*.js
.history

MCP_APPS_implementation_reference/

# MCPB bundle (generated by mcpb pack)
*.mcpb

# Private keys
*.pem
# Eval artefacts: every report, log and roll-up the eval scripts write. A
# committed one goes stale with the next run; the PR it measures quotes it.
evals/scenarios/runs*.jsonl
evals/capability/report*.json
evals/capability/runs/
evals/capability/medians.md
evals/comparison.md
evals/phase-comparison.md
evals/phase-results.json

# A baseline checkout placed inside the repo (`EVAL_BASELINE_DIR=.eval-baseline`).
/.eval-baseline/
