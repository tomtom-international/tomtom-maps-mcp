# TomTom API key - required
# Get your key from https://developer.tomtom.com/
TOMTOM_API_KEY=your_tomtom_api_key_here

# Port for the HTTP server (default: 3000)
PORT=3000

# How long a dataset_id stays resolvable, in seconds (default: 600 = 10 min).
# The store is per-process and capped at 256 MB total and 64 MB per caller, so
# memory is bounded whatever this is set to — but on a SHARED server every minute
# an abandoned dataset stays resident is budget its other tenants cannot use.
# The default is set for the shared case, where the wrong value costs someone
# other than whoever chose it. Single-user stdio can raise it freely. Every tool
# response reports `dataset_expires_in_seconds`, so the model can tell whether a
# handle is still worth using rather than guessing at a policy nobody told it.
# DATASET_TTL_SECONDS=600

# Log level (default: info)
# Available levels: debug, info, warn, error
# Use "debug" for local development to see all logs
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Evals (evals/) — optional. Every suite SKIPS silently without a model key,
# and a skipped suite prints green, so an unconfigured run looks like a pass.
# ---------------------------------------------------------------------------

# The capability benchmark additionally spends real TomTom quota, using the
# TOMTOM_API_KEY above.

# Pick ONE provider. Precedence is Azure -> Anthropic -> OpenAI, silently, so
# set EVAL_PROVIDER when several keys are present — it throws on missing
# credentials instead of quietly running against a different provider.
# EVAL_PROVIDER=azure

# Azure. The agent toolkit's .env works here unedited, which is what keeps the
# selection numbers comparable to the toolkit's own suite. Note that Azure
# addresses DEPLOYMENTS, not model names: the ids below are your deployment
# names. Defaults to the toolkit's own pair, gpt-5.1 + gpt-4.1.
# AZURE_RESOURCE_NAME=your_azure_resource_name
# AZURE_API_KEY=your_azure_api_key
# AZURE_API_VERSION=
# AZURE_MODEL_IDS=gpt-5.1,gpt-4.1
# AZURE_JUDGE_DEPLOYMENT_ID=

# ...or Anthropic. Defaults to claude-opus-5 alone.
# ANTHROPIC_API_KEY=your_anthropic_api_key

# ...or OpenAI. EVAL_MODEL_IDS is REQUIRED here — no default is shipped, since a
# guessed model id would 404 at run time and read as a harness bug.
# OPENAI_API_KEY=your_openai_api_key

# Overrides the model list for any provider. Selection scenarios run EVERY id
# listed; the capability benchmark runs only the first.
# EVAL_MODEL_IDS=gpt-5.1

# Judge model for the capability benchmark. Defaults to the first model tested.
# EVAL_JUDGE_MODEL_ID=

# Fan out over every examplePrompt in the registry rather than the canonical one.
# SCENARIOS_FULL=1

# Drive a real bin/tomtom-mcp.js subprocess instead of in-process tools. Needs a
# fresh `pnpm build`; required for any run against another checkout.
# EVAL_TRANSPORT=stdio

# Score a DIFFERENT checkout's server — how the current tool surface is measured
# against the one it replaced. See evals/README.md; set up with
# `pnpm evals:baseline:setup`, then `pnpm evals:ab`.
# EVAL_SERVER_ROOT=../tomtom-mcp-baseline
# EVAL_LABEL=baseline

# Both halves of a comparison must use the same model and the same transport, or
# `pnpm evals:compare` refuses to report them. Set this only if you mean to
# compare across models and will say so wherever you quote the result.
# EVAL_ALLOW_MISMATCH=1
