# TomTom API key - required
# Get your key from https://developer.tomtom.com/
TOMTOM_API_KEY=your_tomtom_api_key_here

# Port for the HTTP server (default: 3000)
PORT=3000

# Log level (default: info)
# Available levels: debug, info, warn, error
# Use "debug" for local development to see all logs
LOG_LEVEL=debug

# HTTP only: port for the Prometheus metrics at /metrics (default: 9090)
# METRICS_PORT=9090

# HTTP only: key for the `session` field of the log lines (default: unset, no session logged)
# Any long random string, e.g. from `openssl rand -hex 32`
# SESSION_HASH_SECRET=

# Tool canary only: the MCP endpoint `node dist/canary.esm.js` checks with TOMTOM_API_KEY
# CANARY_MCP_URL=http://localhost:3000/mcp
