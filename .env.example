# TomTom API key - required
# Get your key from https://developer.tomtom.com/
TOMTOM_API_KEY=your_tomtom_api_key_here

# Port for the HTTP server (default: 3000)
PORT=3000

# Log level (default: info)
# Available levels: debug, info, warn, error
# Use "debug" for local development to see all logs
LOG_LEVEL=debug

# Seconds the server holds a result's dataset after it was last used (default: 600)
# DATASET_TTL_SECONDS=600

# HTTP only: "true" serves tomtom-analyse-datasets and tomtom-derive-datasets, which run
# model-written code that can reach the network. Set it only where egress is limited.
# DATASET_CODE_OVER_HTTP=false
